{
  "name": "@prmichaelsen/firebase-admin-sdk-v8",
  "version": "2.0.14",
  "description": "Firebase Admin SDK for Cloudflare Workers and edge runtimes using REST APIs",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prmichaelsen/firebase-admin-sdk-v8.git"
  },
  "bugs": {
    "url": "https://github.com/prmichaelsen/firebase-admin-sdk-v8/issues"
  },
  "homepage": "https://github.com/prmichaelsen/firebase-admin-sdk-v8#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "publish": "npm run build && npm publish"
  },
  "keywords": [
    "firebase",
    "admin",
    "cloudflare",
    "workers",
    "edge",
    "firestore",
    "auth",
    "jwt"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  }
}
